# Copy this file to .env and fill in your values

# Set to true to bypass the live Pega APIs and run the complete UI workflow locally.
# Set to false for normal API-backed operation.
VITE_MOCK_MODE=false

VITE_CLIENT_ID=your_client_id_here
VITE_CLIENT_SECRET=your_client_secret_here
VITE_TOKEN_URL=https://your-pega-instance/prweb/PRRestService/oauth2/v1/token
VITE_API_BASE=https://your-pega-instance/prweb/PRServlet/app/genai/api/application/v2
VITE_ASSIGNMENT_API_BASE=https://your-pega-instance/prweb/app/genai/api/application/v2
VITE_CASE_ID=YOUR-CASE-ID-HERE
